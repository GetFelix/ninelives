# aarch64, every target: architecture hardening and CPU support. Same
# comment rule as common.config.

# S6, T16: one system call ABI, so a seccomp filter has one table to get right.
# CONFIG_COMPAT is not set

# T16: no perf_event_open at all on aarch64.
# CONFIG_PERF_EVENTS is not set

# T16: return addresses on a shadow stack, pointer authentication, branch targets.
CONFIG_SHADOW_CALL_STACK=y
CONFIG_ARM64_PTR_AUTH=y
CONFIG_ARM64_PTR_AUTH_KERNEL=y
CONFIG_ARM64_BTI=y
CONFIG_ARM64_BTI_KERNEL=y

# T16: memory tagging where the CPU has it (MTE needs the tagged address ABI,
# hardware tag KASAN uses MTE); E0PD and PAN keep user and kernel apart.
CONFIG_ARM64_TAGGED_ADDR_ABI=y
CONFIG_ARM64_MTE=y
CONFIG_KASAN=y
CONFIG_KASAN_HW_TAGS=y
CONFIG_ARM64_E0PD=y
CONFIG_ARM64_SW_TTBR0_PAN=y
CONFIG_ARM64_EPAN=y

# T16: user space return addresses on the guarded control stack, where the CPU has it.
CONFIG_ARM64_GCS=y

# T16: mmap randomisation at the maximum for 48-bit VAs with 4K pages.
CONFIG_ARCH_MMAP_RND_BITS=33

# T56, S17: kernel unmapped at EL0 (the aarch64 equivalent of pti=on) and the
# branch history mitigation. Both hide behind EXPERT, so allnoconfig drops them.
CONFIG_UNMAP_KERNEL_AT_EL0=y
CONFIG_MITIGATE_SPECTRE_BRANCH_HISTORY=y

# everything: workarounds for Arm and Ampere core errata, applied only on an
# affected CPU. Those that need COMPAT, KVM, trace or AMU are not reachable here.
CONFIG_AMPERE_ERRATUM_AC03_CPU_38=y
CONFIG_AMPERE_ERRATUM_AC04_CPU_23=y
CONFIG_ARM64_ERRATUM_826319=y
CONFIG_ARM64_ERRATUM_827319=y
CONFIG_ARM64_ERRATUM_824069=y
CONFIG_ARM64_ERRATUM_819472=y
CONFIG_ARM64_ERRATUM_832075=y
CONFIG_ARM64_ERRATUM_843419=y
CONFIG_ARM64_ERRATUM_1024718=y
CONFIG_ARM64_ERRATUM_1165522=y
CONFIG_ARM64_ERRATUM_1319367=y
CONFIG_ARM64_ERRATUM_1530923=y
CONFIG_ARM64_ERRATUM_1463225=y
CONFIG_ARM64_ERRATUM_1508412=y
CONFIG_ARM64_ERRATUM_2051678=y
CONFIG_ARM64_ERRATUM_2077057=y
CONFIG_ARM64_ERRATUM_2658417=y
CONFIG_ARM64_ERRATUM_2054223=y
CONFIG_ARM64_ERRATUM_2067961=y
CONFIG_ARM64_ERRATUM_2645198=y
CONFIG_ARM64_ERRATUM_2966298=y
CONFIG_ARM64_ERRATUM_3117295=y
CONFIG_ARM64_ERRATUM_3194386=y
CONFIG_ARM64_ERRATUM_4118414=y
