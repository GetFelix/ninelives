# Both architectures, every target. Applied after upstream allnoconfig and
# hardening.config (docs/components/kernel.md, "How the config is produced").
#
# Every option line sits under a comment of the form "# <who>: <why>",
# naming the requirement, component or target that needs it. A blank line
# ends the group the comment covers. scripts/check_kernel_config.py fails on
# an option without one.

# kconfig: makes the core options below visible, so each one is listed here
# instead of inherited from a default.
CONFIG_EXPERT=y

# everything: uids, timer_create, a kernel log, BUG() that stops.
CONFIG_MULTIUSER=y
CONFIG_POSIX_TIMERS=y
CONFIG_PRINTK=y
CONFIG_BUG=y

# everything: one kernel serves every CPU of the machine.
CONFIG_SMP=y

# felix: QUIC pacing and tokio timers need sub-tick resolution.
CONFIG_HIGH_RES_TIMERS=y

# everything: run ELF programs. No other format (S1, S2).
CONFIG_BINFMT_ELF=y
# CONFIG_BINFMT_SCRIPT is not set
# CONFIG_BINFMT_MISC is not set

# image: the block layer for virtio-blk, dm-verity and ext4.
CONFIG_BLOCK=y
CONFIG_BLK_DEV=y

# image: the serial console and /dev/console.
CONFIG_TTY=y

# K4: /proc/config.gz lets the qemu test compare the running config.
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y

# S2, vm.memfd_noexec: PID_NS is the only namespace kept, and it needs NAMESPACES.
CONFIG_NAMESPACES=y
CONFIG_PID_NS=y

# S6, T16: no unprivileged namespaces or other namespace types.
# CONFIG_USER_NS is not set
# CONFIG_NET_NS is not set
# CONFIG_IPC_NS is not set
# CONFIG_UTS_NS is not set
# CONFIG_TIME_NS is not set

# image: microcode and driver firmware are built in, never loaded from disk.
CONFIG_FW_LOADER=y

# felix, felixd, init: tokio's reactor, Rust's locks, the init's event loop.
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_EVENTFD=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y

# felix: flock on each log directory (felix-storage disk_log/dir_lock.rs).
CONFIG_FILE_LOCKING=y

# init: /run, /tmp and memfds.
CONFIG_SHMEM=y
CONFIG_TMPFS=y
CONFIG_MEMFD_CREATE=y

# felix, felixd: glibc malloc returns memory with madvise.
CONFIG_ADVISE_SYSCALLS=y

# felix, felixd: glibc registers rseq per thread; Rust and wasmtime use membarrier.
CONFIG_MEMBARRIER=y
CONFIG_RSEQ=y

# S6, T16: unused system calls and interfaces with a history of bugs.
# CONFIG_UID16 is not set
# CONFIG_SGETMASK_SYSCALL is not set
# CONFIG_SYSFS_SYSCALL is not set
# CONFIG_FHANDLE is not set
# CONFIG_AIO is not set
# CONFIG_IO_URING is not set
# CONFIG_CACHESTAT_SYSCALL is not set
# CONFIG_SYSVIPC is not set
# CONFIG_POSIX_MQUEUE is not set
# CONFIG_CHECKPOINT_RESTORE is not set
# CONFIG_KCMP is not set
# CONFIG_USERFAULTFD is not set
# CONFIG_KEYS is not set
# CONFIG_BPF_SYSCALL is not set
# CONFIG_CRYPTO_USER_API_HASH is not set
# CONFIG_CRYPTO_USER_API_SKCIPHER is not set
# CONFIG_CRYPTO_USER_API_RNG is not set
# CONFIG_CRYPTO_USER_API_AEAD is not set

# S2, T16: no runtime code loading. Everything the image needs is built in.
# CONFIG_MODULES is not set
# CONFIG_KEXEC is not set
# CONFIG_KEXEC_FILE is not set
# CONFIG_KEXEC_HANDOVER is not set
# CONFIG_CRASH_DUMP is not set

# T22: hibernation writes all memory to disk and reads it back as trusted.
# CONFIG_HIBERNATION is not set
# CONFIG_SUSPEND is not set

# S24, T16: the kernel never starts a user program on its own; the helper path is empty.
CONFIG_STATIC_USERMODEHELPER=y
CONFIG_STATIC_USERMODEHELPER_PATH=""
# CONFIG_UEVENT_HELPER is not set

# S24, T22: no core dumps at all, so there is no core_pattern to abuse.
# CONFIG_COREDUMP is not set
# CONFIG_ELF_CORE is not set

# T16: classic BPF for seccomp and socket filters is JIT-compiled.
# BPF_JIT_ALWAYS_ON needs BPF_SYSCALL, so the interpreter is still built;
# sysctl.net.core.bpf_jit_enable=1 on the command line keeps the JIT on.
CONFIG_BPF_JIT=y

# S6: each service's seccomp filter.
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y

# S6, T16, T17: the LSMs. Only these three run, in this order.
CONFIG_SECURITY=y
CONFIG_SECURITYFS=y
CONFIG_SECURITY_LANDLOCK=y
CONFIG_SECURITY_YAMA=y
CONFIG_SECURITY_LOCKDOWN_LSM=y
CONFIG_SECURITY_LOCKDOWN_LSM_EARLY=y
CONFIG_LOCK_DOWN_KERNEL_FORCE_CONFIDENTIALITY=y
CONFIG_LSM="landlock,lockdown,yama"

# S6: no MAC policy nobody writes, and nothing LoadPin or SafeSetID would guard.
# CONFIG_SECURITY_SELINUX is not set
# CONFIG_SECURITY_APPARMOR is not set
# CONFIG_SECURITY_SMACK is not set
# CONFIG_SECURITY_TOMOYO is not set
# CONFIG_SECURITY_LOADPIN is not set
# CONFIG_SECURITY_SAFESETID is not set
# CONFIG_SECURITY_IPE is not set

# T17, T67: own /proc/self/mem writes obey page permissions.
CONFIG_PROC_MEM_NO_FORCE=y

# T16: reading the kernel log needs CAP_SYSLOG, which no process keeps.
CONFIG_SECURITY_DMESG_RESTRICT=y

# T16: no symbol table, debug, tracing or memory dump interfaces.
# CONFIG_KALLSYMS is not set
# CONFIG_DEBUG_FS is not set
# CONFIG_FTRACE is not set
# CONFIG_KPROBES is not set
# CONFIG_UPROBES is not set
# CONFIG_PROFILING is not set
# CONFIG_PROC_KCORE is not set
# CONFIG_MAGIC_SYSRQ is not set
# CONFIG_KGDB is not set
# CONFIG_DEVMEM is not set
# CONFIG_DEVPORT is not set
# CONFIG_AUDIT is not set

# T16: memory holding credentials is never written to disk.
# CONFIG_SWAP is not set

# T16: SCHED_STACK_END_CHECK and the DEBUG_ checks below need DEBUG_KERNEL,
# which adds nothing by itself.
CONFIG_DEBUG_KERNEL=y
CONFIG_SCHED_STACK_END_CHECK=y

# T16: stated again from hardening.config because the design depends on them.
CONFIG_STACKPROTECTOR_STRONG=y
CONFIG_VMAP_STACK=y
CONFIG_RANDOMIZE_KSTACK_OFFSET=y
CONFIG_RANDOMIZE_KSTACK_OFFSET_DEFAULT=y
CONFIG_INIT_STACK_ALL_ZERO=y
CONFIG_HARDENED_USERCOPY=y
CONFIG_HARDENED_USERCOPY_DEFAULT_ON=y
CONFIG_FORTIFY_SOURCE=y
CONFIG_UBSAN_BOUNDS=y
CONFIG_UBSAN_TRAP=y
CONFIG_INIT_ON_ALLOC_DEFAULT_ON=y
CONFIG_INIT_ON_FREE_DEFAULT_ON=y
CONFIG_SLAB_FREELIST_RANDOM=y
CONFIG_SLAB_FREELIST_HARDENED=y
CONFIG_SLAB_BUCKETS=y
CONFIG_RANDOM_KMALLOC_CACHES=y
CONFIG_SHUFFLE_PAGE_ALLOCATOR=y
CONFIG_KFENCE=y
CONFIG_LIST_HARDENED=y
CONFIG_PAGE_TABLE_CHECK_ENFORCED=y
CONFIG_STRICT_KERNEL_RWX=y
CONFIG_RANDOMIZE_BASE=y
CONFIG_CFI=y
# CONFIG_CFI_PERMISSIVE is not set

# T16: hardening the upstream fragment does not carry.
CONFIG_ZERO_CALL_USED_REGS=y
CONFIG_BUG_ON_DATA_CORRUPTION=y
CONFIG_DEBUG_WX=y
CONFIG_DEBUG_VIRTUAL=y
CONFIG_DEBUG_SG=y
CONFIG_DEBUG_NOTIFIERS=y
# CONFIG_SLAB_MERGE_DEFAULT is not set
CONFIG_DEFAULT_MMAP_MIN_ADDR=65536

# S5: a fixed layout seed would have to be published, which defeats it.
CONFIG_RANDSTRUCT_NONE=y

# S2: no Rust in the kernel, so one toolchain builds it.
# CONFIG_RUST is not set

# T54: strict IOMMU invalidation, and no DMA between EFI hand-off and IOMMU setup.
CONFIG_IOMMU_SUPPORT=y
CONFIG_IOMMU_DEFAULT_DMA_STRICT=y

# T56, S17: every CPU mitigation the architecture offers.
CONFIG_CPU_MITIGATIONS=y

# init: cgroup v2 with the cpu, memory, io and pids controllers.
CONFIG_CGROUPS=y
CONFIG_MEMCG=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_SCHED=y
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_BLK_CGROUP=y
CONFIG_BLK_CGROUP_IOCOST=y

# init: proc with hidepid, sysfs, devtmpfs mounted by the init itself.
CONFIG_PROC_FS=y
CONFIG_PROC_SYSCTL=y
CONFIG_SYSFS=y
CONFIG_DEVTMPFS=y
# CONFIG_DEVTMPFS_MOUNT is not set

# image: every target boots through UEFI and is described by ACPI.
CONFIG_EFI=y
CONFIG_ACPI=y

# init: the ACPI power button reaches PID 1 as KEY_POWER.
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_ACPI_BUTTON=y

# init: /dev/watchdog that nothing can disarm; the software one is the fallback.
CONFIG_WATCHDOG=y
CONFIG_WATCHDOG_NOWAYOUT=y
CONFIG_SOFT_WATCHDOG=y

# init: project quotas on the ext4 data partition (prjquota needs QFMT_V2).
CONFIG_EXT4_FS=y
CONFIG_QUOTA=y
CONFIG_QFMT_V2=y

# image: the erofs root on dm-verity, set up from dm-mod.create with no initrd.
CONFIG_MISC_FILESYSTEMS=y
CONFIG_MD=y
CONFIG_BLK_DEV_DM=y
CONFIG_DM_INIT=y
CONFIG_DM_VERITY=y
CONFIG_CRYPTO_SHA256=y
CONFIG_EROFS_FS=y

# image: a bad block panics instead of being repaired; the root hash is signed in the UKI.
# CONFIG_DM_VERITY_FEC is not set
# CONFIG_DM_VERITY_VERIFY_ROOTHASH_SIG is not set

# image, T16: the root is uncompressed and has no xattrs, so no decompressor is built.
# CONFIG_EROFS_FS_ZIP is not set
# CONFIG_EROFS_FS_XATTR is not set
# CONFIG_EROFS_FS_POSIX_ACL is not set

# image: no initrd; microcode is built in.
# CONFIG_BLK_DEV_INITRD is not set

# image: GPT only; partition names reach the init in uevents.
CONFIG_PARTITION_ADVANCED=y
CONFIG_EFI_PARTITION=y
# CONFIG_MSDOS_PARTITION is not set

# T54: filesystems the image never mounts.
# CONFIG_FUSE_FS is not set
# CONFIG_OVERLAY_FS is not set
# CONFIG_NETWORK_FILESYSTEMS is not set
# CONFIG_SQUASHFS is not set
# CONFIG_VFAT_FS is not set
# CONFIG_MSDOS_FS is not set
# CONFIG_EFIVAR_FS is not set

# felix, felixd: TCP and QUIC over IPv4 and IPv6, Unix sockets.
CONFIG_NET=y
CONFIG_INET=y
CONFIG_IPV6=y
CONFIG_UNIX=y

# image: the DHCP client sends before it has an address.
CONFIG_PACKET=y

# S7, S18: one nftables ruleset loaded at boot. ADVANCED makes every
# netfilter option a visible choice, so allnoconfig turns each one off.
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NF_CONNTRACK=y
CONFIG_NFT_CT=y
CONFIG_NFT_REJECT=y
CONFIG_NFT_REJECT_INET=y
CONFIG_NFT_LIMIT=y

# S7, T18: nftables is the only packet filter.
# CONFIG_NETFILTER_XTABLES is not set
# CONFIG_IP_NF_IPTABLES is not set
# CONFIG_IP6_NF_IPTABLES is not set
# CONFIG_IP_NF_ARPTABLES is not set
# CONFIG_BRIDGE_NF_EBTABLES is not set
# CONFIG_NF_TABLES_ARP is not set
# CONFIG_NF_TABLES_BRIDGE is not set
# CONFIG_NF_TABLES_NETDEV is not set
# CONFIG_NF_NAT is not set
# CONFIG_NF_CT_NETLINK is not set
# CONFIG_NETFILTER_NETLINK_QUEUE is not set
# CONFIG_NETFILTER_NETLINK_LOG is not set
# CONFIG_NETFILTER_NETLINK_ACCT is not set
# CONFIG_NETFILTER_NETLINK_OSF is not set

# S7, T18: no in-kernel parsers for application protocols.
# CONFIG_NF_CONNTRACK_FTP is not set
# CONFIG_NF_CONNTRACK_SIP is not set
# CONFIG_NF_CONNTRACK_H323 is not set
# CONFIG_NF_CONNTRACK_IRC is not set
# CONFIG_NF_CONNTRACK_TFTP is not set
# CONFIG_NF_CONNTRACK_AMANDA is not set
# CONFIG_NF_CONNTRACK_PPTP is not set
# CONFIG_NF_CONNTRACK_SANE is not set
# CONFIG_NF_CONNTRACK_SNMP is not set
# CONFIG_NF_CONNTRACK_NETBIOS_NS is not set

# S7, T70: no traffic control, so nothing rewrites or mirrors packets after netfilter.
# CONFIG_NET_SCHED is not set

# T18, T70: no other way to filter, tunnel or redirect traffic.
# CONFIG_TUN is not set
# CONFIG_BRIDGE is not set
# CONFIG_VLAN_8021Q is not set
# CONFIG_MACVLAN is not set
# CONFIG_IPVLAN is not set
# CONFIG_VETH is not set
# CONFIG_VXLAN is not set
# CONFIG_GENEVE is not set
# CONFIG_NET_IPIP is not set
# CONFIG_NET_IPGRE_DEMUX is not set
# CONFIG_IPV6_SIT is not set
# CONFIG_IPV6_TUNNEL is not set
# CONFIG_WIREGUARD is not set
# CONFIG_XFRM_USER is not set
# CONFIG_INET_ESP is not set
# CONFIG_INET6_ESP is not set
# CONFIG_MPLS is not set
# CONFIG_IP_ADVANCED_ROUTER is not set
# CONFIG_IP_MULTIPLE_TABLES is not set
# CONFIG_IPV6_MULTIPLE_TABLES is not set
# CONFIG_LWTUNNEL is not set
# CONFIG_OPENVSWITCH is not set

# T16: protocol families no service uses.
# CONFIG_IP_SCTP is not set
# CONFIG_TIPC is not set
# CONFIG_RDS is not set
# CONFIG_L2TP is not set
# CONFIG_CAN is not set
# CONFIG_BT is not set
# CONFIG_WIRELESS is not set
# CONFIG_NFC is not set
# CONFIG_X25 is not set
# CONFIG_AX25 is not set
# CONFIG_ATM is not set
# CONFIG_VSOCKETS is not set
# CONFIG_INET_DIAG is not set
# CONFIG_PACKET_DIAG is not set
# CONFIG_UNIX_DIAG is not set
# CONFIG_NETLINK_DIAG is not set

# T54: buses and devices no M0 to M2 target has.
# CONFIG_USB_SUPPORT is not set
# CONFIG_USB4 is not set
# CONFIG_FIREWIRE is not set
# CONFIG_SOUND is not set
# CONFIG_DRM is not set
# CONFIG_FB is not set
# CONFIG_HID_SUPPORT is not set
# CONFIG_WLAN is not set
# CONFIG_BLK_DEV_NVME is not set
# CONFIG_SCSI is not set
# CONFIG_VIRTUALIZATION is not set
# CONFIG_VT is not set
# CONFIG_LEGACY_PTYS is not set
