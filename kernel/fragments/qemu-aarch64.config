# The qemu target, aarch64 only (virt). Same comment rule as common.config.

# qemu: virt is described by ACPI under UEFI; SPCR names the console.
CONFIG_ACPI_SPCR_TABLE=y

# qemu: the generic ECAM PCI host bridge.
CONFIG_PCI_HOST_GENERIC=y

# qemu: the serial console on the PL011 UART.
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y

# qemu: the PL031 real-time clock.
CONFIG_RTC_DRV_PL031=y
