# The qemu target, x86_64 only (q35). Same comment rule as common.config.

# qemu: KVM guest support, including kvm-clock.
CONFIG_HYPERVISOR_GUEST=y
CONFIG_PARAVIRT=y
CONFIG_KVM_GUEST=y

# qemu: the serial console on the legacy UART.
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y

# qemu: the CMOS real-time clock.
CONFIG_RTC_DRV_CMOS=y
