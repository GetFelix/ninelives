# The qemu target (M0 to M2), both architectures: q35 on x86_64 and virt on
# aarch64, booted through UEFI. Drivers that exist on one architecture only
# are in qemu-<arch>.config. Same comment rule as common.config.

# qemu: virtio over PCI with MSI-X, modern devices only.
CONFIG_PCI=y
CONFIG_PCI_MSI=y
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_PCI=y
# CONFIG_VIRTIO_PCI_LEGACY is not set

# qemu: virtio-blk holds the ESP, the root, its verity tree and the data partition.
CONFIG_VIRTIO_BLK=y

# qemu, N2: virtio-net; UDP GSO and GRO come from the core.
CONFIG_NETDEVICES=y
CONFIG_NET_CORE=y
CONFIG_VIRTIO_NET=y

# qemu: virtio-rng seeds the kernel's random pool at boot.
CONFIG_HW_RANDOM=y
CONFIG_HW_RANDOM_VIRTIO=y

# qemu, S15: the hypervisor's clock for chrony, and an RTC so time is right from boot.
CONFIG_RTC_CLASS=y
CONFIG_RTC_HCTOSYS=y
CONFIG_PTP_1588_CLOCK=y
CONFIG_PTP_1588_CLOCK_KVM=y

# qemu, init: the i6300esb watchdog is a PCI device on both machines.
CONFIG_I6300ESB_WDT=y

# T54: virtio devices nothing uses.
# CONFIG_VIRTIO_BALLOON is not set
# CONFIG_VIRTIO_INPUT is not set
# CONFIG_VIRTIO_CONSOLE is not set
# CONFIG_VIRTIO_MMIO is not set
