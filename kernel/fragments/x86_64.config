# x86_64, every target: architecture hardening and CPU support. Same comment
# rule as common.config.

# everything: a 64-bit kernel.
CONFIG_64BIT=y

# image: the UKI's stub starts the kernel through its EFI entry point.
CONFIG_EFI_STUB=y

# everything: room for the vCPU counts N1's cloud machines have.
CONFIG_NR_CPUS=512

# T56, S17: microcode for both vendors, loaded early from built-in firmware only.
CONFIG_CPU_SUP_INTEL=y
CONFIG_CPU_SUP_AMD=y
CONFIG_MICROCODE=y
# CONFIG_MICROCODE_LATE_LOADING is not set

# S6, T16: one system call ABI, so a seccomp filter has one table to get right.
# CONFIG_IA32_EMULATION is not set
# CONFIG_X86_X32_ABI is not set

# S6, T16: unused x86 interfaces to the hardware and to segment tables.
# CONFIG_MODIFY_LDT_SYSCALL is not set
# CONFIG_X86_IOPL_IOPERM is not set
# CONFIG_X86_MSR is not set
# CONFIG_X86_CPUID is not set
# CONFIG_X86_16BIT is not set
CONFIG_LEGACY_VSYSCALL_NONE=y

# everything: a hardware memory error is handled and reported, not a silent reset.
CONFIG_X86_MCE=y
CONFIG_X86_MCE_INTEL=y
CONFIG_X86_MCE_AMD=y

# T16: user mode cannot read descriptor table addresses (sgdt, sidt).
CONFIG_X86_UMIP=y

# T16: hardening.config's x86 lines the design depends on.
CONFIG_RANDOMIZE_MEMORY=y
CONFIG_X86_KERNEL_IBT=y
CONFIG_INTEL_IOMMU=y
CONFIG_INTEL_IOMMU_DEFAULT_ON=y
CONFIG_AMD_IOMMU=y
CONFIG_EFI_DISABLE_PCI_DMA=y

# T16: FineIBT replaces kCFI on CPUs with IBT (cfi=auto); kCFI everywhere else.
CONFIG_CFI_AUTO_DEFAULT=y

# T16: mmap randomisation at the architecture's maximum.
CONFIG_ARCH_MMAP_RND_BITS=32

# T56: TSX has carried several data leaks and nothing uses it.
CONFIG_X86_INTEL_TSX_MODE_OFF=y

# T56, S17: every mitigation the pinned tree offers; policy.toml lists them
# so a new one in a point release is noticed.
CONFIG_MITIGATION_PAGE_TABLE_ISOLATION=y
CONFIG_MITIGATION_RETPOLINE=y
CONFIG_MITIGATION_RETHUNK=y
CONFIG_MITIGATION_UNRET_ENTRY=y
CONFIG_MITIGATION_CALL_DEPTH_TRACKING=y
CONFIG_MITIGATION_IBPB_ENTRY=y
CONFIG_MITIGATION_IBRS_ENTRY=y
CONFIG_MITIGATION_SRSO=y
CONFIG_MITIGATION_SLS=y
CONFIG_MITIGATION_GDS=y
CONFIG_MITIGATION_RFDS=y
CONFIG_MITIGATION_SPECTRE_BHI=y
CONFIG_MITIGATION_MDS=y
CONFIG_MITIGATION_TAA=y
CONFIG_MITIGATION_MMIO_STALE_DATA=y
CONFIG_MITIGATION_L1TF=y
CONFIG_MITIGATION_RETBLEED=y
CONFIG_MITIGATION_SPECTRE_V1=y
CONFIG_MITIGATION_SPECTRE_V2=y
CONFIG_MITIGATION_SRBDS=y
CONFIG_MITIGATION_SSB=y
CONFIG_MITIGATION_ITS=y
CONFIG_MITIGATION_TSA=y

# T16: x86_64 selects perf unconditionally; perf_event_paranoid=2 and lockdown narrow it.
CONFIG_PERF_EVENTS=y
